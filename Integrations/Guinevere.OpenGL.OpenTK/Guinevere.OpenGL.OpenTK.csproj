<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>$(MSBuildProjectName.Replace("-", "_"))</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- NuGet Package Properties -->
        <PackageId>MASS4.Guinevere.OpenGL.OpenTK</PackageId>
        <Title>Guinevere - OpenGL - OpenTK</Title>
        <Description>OpenGL via OpenTK integration for Guinevere</Description>
        <Company>MASS4</Company>
        <Product>Guinevere</Product>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Version>1.8.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="OpenTK" Version="4.9.4"/>
        <PackageReference Include="SkiaSharp" Version="4.152.0" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.152.0" />
        <PackageReference Include="SkiaSharp.Views.Desktop.Common" Version="4.152.0" />
        <PackageReference Include="SkiaSharp.Vulkan.SharpVk" Version="4.152.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Guinevere\Guinevere.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Update="Shaders\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Fonts\font.ttf" />
        <EmbeddedResource Include="Fonts\icons.ttf" />
        <EmbeddedResource Include="Shaders\*"/>
    </ItemGroup>
</Project>
