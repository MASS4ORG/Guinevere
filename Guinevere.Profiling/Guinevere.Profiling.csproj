<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>MASS4.Guinevere.Profiling</PackageId>
    <Version>0.1.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Guinevere/Guinevere.csproj" />
    <ProjectReference Include="../Guinevere.Scripting/Guinevere.Scripting.csproj" />
    <PackageReference Include="MASS4.Profiling" Version="[0.1.0]" Condition="'$(ProfilingLocalPath)' == ''" />
    <ProjectReference Include="$(ProfilingLocalPath)/Profiling/Profiling.csproj" Condition="'$(ProfilingLocalPath)' != ''"
                      AdditionalProperties="Configuration=$(Configuration)" />
  </ItemGroup>
</Project>
