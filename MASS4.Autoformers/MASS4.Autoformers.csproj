<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>MASS4.Autoformers</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- NuGet Package Properties -->
        <Title>MASS4 Autoformers</Title>
        <PackageId>MASS4.Autoformers</PackageId>
        <Description>A GUI-free form model: reflects plain C# objects into sections of editable fields, collections and actions, driven by MASS4.Attributes. Persistence, null rules and failure reporting are supplied by the consumer.</Description>
        <Company>MASS4</Company>
        <Product>Guinevere</Product>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Version>1.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MASS4.Attributes\MASS4.Attributes.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Guinevere.Tests"/>
    </ItemGroup>

</Project>
