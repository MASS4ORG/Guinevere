// A monochrome dark color theme: Material 3 roles with a neutral blue-grey primary. Token-only: it layers over
// guinevere.default.pss, whose control slots follow these roles.
@const theme-id = "org.mass4.guinevere.mono-dark";
@const theme-name = "Material You Mono Dark";
@const theme-kind = dark;

$md-primary = #bbc3d2;
$md-on-primary = #232731;
$md-primary-container = #3a4150;
$md-on-primary-container = #d7dae0;
$md-secondary = #aab1bf;
$md-on-secondary = #232731;
$md-secondary-container = #323946;
$md-on-secondary-container = #d7dae0;
$md-tertiary = #b3b9c6;
$md-on-tertiary = #232731;
$md-tertiary-container = #3a4150;
$md-on-tertiary-container = #d7dae0;
$md-surface = #181a1f;
$md-surface-dim = #181a1f;
$md-surface-bright = #373c47;
$md-surface-container-lowest = #13151a;
$md-surface-container-low = #1e222a;
$md-surface-container = #232731;
$md-surface-container-high = #2c323d;
$md-surface-container-highest = #363d49;
$md-on-surface = #d7dae0;
$md-on-surface-variant = #aab1bf;
$md-surface-variant = #2d333f;
$md-outline = #6f788a;
$md-outline-variant = #2d333f;
$md-inverse-surface = #d7dae0;
$md-inverse-on-surface = #232731;
$md-inverse-primary = #4c566a;

$md-success = #50a14f;
$md-info = #7fb3d5;
