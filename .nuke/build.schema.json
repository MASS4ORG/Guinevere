{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "definitions": {
    "Host": {
      "type": "string",
      "enum": [
        "AppVeyor",
        "AzurePipelines",
        "Bamboo",
        "Bitbucket",
        "Bitrise",
        "GitHubActions",
        "GitLab",
        "Jenkins",
        "Rider",
        "SpaceAutomation",
        "TeamCity",
        "Terminal",
        "TravisCI",
        "VisualStudio",
        "VSCode"
      ]
    },
    "ExecutableTarget": {
      "type": "string",
      "enum": [
        "BuildExamples",
        "CheckNewCommits",
        "Clean",
        "CleanExamples",
        "Compile",
        "CreateExamplesReadme",
        "CreateReleaseCommit",
        "CreateReleaseTag",
        "GitHubCreateRelease",
        "GitHubCreateTag",
        "GitLabCreateRelease",
        "GitLabCreateTag",
        "Pack",
        "PackageExamples",
        "PackNuGet",
        "Publish",
        "PublishExamples",
        "PushNuGet",
        "Restore",
        "ShowCurrentVersion",
        "Test",
        "TestReport",
        "UpdateChangelog",
        "UpdateProjectVersions"
      ]
    },
    "Verbosity": {
      "type": "string",
      "description": "",
      "enum": [
        "Verbose",
        "Normal",
        "Minimal",
        "Quiet"
      ]
    },
    "NukeBuild": {
      "properties": {
        "Continue": {
          "type": "boolean",
          "description": "Indicates to continue a previously failed build attempt"
        },
        "Help": {
          "type": "boolean",
          "description": "Shows the help text for this build assembly"
        },
        "Host": {
          "description": "Host for execution. Default is 'automatic'",
          "$ref": "#/definitions/Host"
        },
        "NoLogo": {
          "type": "boolean",
          "description": "Disables displaying the NUKE logo"
        },
        "Partition": {
          "type": "string",
          "description": "Partition to use on CI"
        },
        "Plan": {
          "type": "boolean",
          "description": "Shows the execution plan (HTML)"
        },
        "Profile": {
          "type": "array",
          "description": "Defines the profiles to load",
          "items": {
            "type": "string"
          }
        },
        "Root": {
          "type": "string",
          "description": "Root directory during build execution"
        },
        "Skip": {
          "type": "array",
          "description": "List of targets to be skipped. Empty list skips all dependencies",
          "items": {
            "$ref": "#/definitions/ExecutableTarget"
          }
        },
        "Target": {
          "type": "array",
          "description": "List of targets to be invoked. Default is '{default_target}'",
          "items": {
            "$ref": "#/definitions/ExecutableTarget"
          }
        },
        "Verbosity": {
          "description": "Logging verbosity during build execution. Default is 'Normal'",
          "$ref": "#/definitions/Verbosity"
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "Configuration": {
          "type": "string",
          "description": "Config to build - Default is 'Debug' (local) or 'Release' (server)"
        },
        "ExampleRuntimes": {
          "type": "array",
          "description": "Runtime identifiers for examples (default: win-x64,linux-x64)",
          "items": {
            "type": "string"
          }
        },
        "ExamplesOutputDirectory": {
          "type": "string",
          "description": "Examples output directory (default: ./examples-output)"
        },
        "GithubRepository": {
          "type": "string",
          "description": "GitHub owner/repo path (default: MASS4ORG/Guinevere)"
        },
        "GithubToken": {
          "type": "string",
          "description": "GitHub token (repo scope, or the Actions-provided GITHUB_TOKEN) with contents:write. Omit to skip pushing/releasing to GitHub",
          "default": "Secrets must be entered via 'nuke :secrets [profile]'"
        },
        "GitlabProjectPath": {
          "type": "string",
          "description": "GitLab group/project path (default: MASS4ORG/guinevere)"
        },
        "GitlabToken": {
          "type": "string",
          "description": "GitLab personal/project access token with api + write_repository scope. Omit to skip pushing/releasing to GitLab",
          "default": "Secrets must be entered via 'nuke :secrets [profile]'"
        },
        "NuGetApiKey": {
          "type": "string",
          "description": "NuGet API key used by PushNuGet. Absent = pack only",
          "default": "Secrets must be entered via 'nuke :secrets [profile]'"
        },
        "NuGetSource": {
          "type": "string",
          "description": "NuGet feed to push to (default: nuget.org)"
        },
        "PublishDirectory": {
          "type": "string",
          "description": "publish-directory (default: ./.publish/{runtimeIdentifier})"
        },
        "PublishReadyToRun": {
          "type": "boolean",
          "description": "publish-ready-to-run (default: false)"
        },
        "PublishSelfContained": {
          "type": "boolean",
          "description": "publish-self-contained (default: set by the project)"
        },
        "PublishSingleFile": {
          "type": "boolean",
          "description": "publish-single-file (default: set by the project)"
        },
        "PublishTrimmed": {
          "type": "boolean",
          "description": "publish-trimmed (default: set by the project)"
        },
        "ReleaseBranch": {
          "type": "string",
          "description": "Branch the release commit is pushed to (default: main)"
        },
        "RuntimeIdentifier": {
          "type": "string",
          "description": "Runtime identifier for the build (e.g., win-x64, linux-x64, osx-x64) (default: linux-x64)"
        },
        "Solution": {
          "type": "string",
          "description": "Path to a solution file that is automatically loaded"
        }
      }
    },
    {
      "$ref": "#/definitions/NukeBuild"
    }
  ]
}
