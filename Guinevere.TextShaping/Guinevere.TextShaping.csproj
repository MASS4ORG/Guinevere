<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Guinevere</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- NuGet Package Properties -->
        <Title>Guinevere - Text Shaping</Title>
        <PackageId>MASS4.Guinevere.TextShaping</PackageId>
        <Description>
            Full OpenType text shaping for Guinevere: ligatures, mark positioning, kerning and complex scripts,
            plugged in with gui.TextShaper.
        </Description>
        <Company>MASS4</Company>
        <Product>Guinevere</Product>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Version>6.3.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp.HarfBuzz" Version="4.153.1" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.1.301" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Guinevere/Guinevere.csproj" />
    </ItemGroup>

</Project>
