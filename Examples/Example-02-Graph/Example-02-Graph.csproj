<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="../../docs/guinevere-badge.png" LogicalName="GuinevereDemos.guinevere-badge.png" />
        <PackageReference Include="MASS4.Graph.Dataflow" Version="[1.1.0]" />
        <PackageReference Include="MASS4.Graph.Interpreter" Version="[1.1.0]" />
        <PackageReference Include="MASS4.Graph.State" Version="[1.1.0]" />
        <ProjectReference Include="../../Guinevere.Graphs/Guinevere.Graphs.csproj" />
        <ProjectReference Include="../../Guinevere.Excalibur/Guinevere.Excalibur.csproj" />
        <ProjectReference Include="../../Integrations/Guinevere.OpenGL.SilkNET/Guinevere.OpenGL.SilkNET.csproj" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Styles/*.pss" LogicalName="Example02.Styles.%(Filename)%(Extension)" />
    </ItemGroup>
</Project>
