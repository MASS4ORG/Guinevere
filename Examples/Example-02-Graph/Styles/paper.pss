$ink = #302c27; $surface = #eee8da; $accent = #365f8b;
graph-playground { background-color = #e8e2d5; color = $ink; font-size = 14; padding = 12; gap = 8; }
graph-heading { color = $ink; }
graph-button, graph-tab, graph-stepper, graph-search {
    background-color = $surface; color = $ink; border-color = #b6aa92; border-width = 1; border-radius = 2; font-size = 14;
}
graph-button:hover, graph-tab:selected, graph-stepper:hover { background-color = #d7e3e8; }
graph-button:focus, graph-tab:focus, graph-toggle:focus { outline-color = $accent; outline-width = 2; }
graph-toggle { color = $ink; font-size = 14; }
graph-toggle-indicator { background-color = $surface; border-color = #b6aa92; border-width = 1; border-radius = 2; }
graph-toggle-indicator:checked { background-color = $accent; }
graph-message { color = $accent; font-size = 14; }
graph-message:error { color = #a62d2a; }
graph-canvas { background-color = #faf6ec; }
graph-grid { stroke = #eae3d2; }
graph-grid:major { stroke = #d9cfb9; }
graph-grid:axis { stroke = #aca086; }
graph-node { background-color = #fffdf6; border-color = #8b7e67; border-radius = 2; color = $ink; }
graph-node:selected { background-color = #e0eaf0; border-color = $accent; }
graph-node:warning { border-color = #9d6800; }
graph-node:error { border-color = #a62d2a; }
graph-header { background-color = #eee8da; border-radius = 2 2 0 0; }
graph-title, graph-port-label { color = $ink; }
graph-port { background-color = #365f8b; }
graph-port:output { background-color = #31775f; }
graph-link { stroke = #6c6252; stroke-width = 1.5; stroke-dasharray = 7 3 2 3; }
graph-link:selected { stroke = #a62d2a; stroke-width = 3; }
graph-link:warning { stroke = #9d6800; }
graph-link:error { stroke = #a62d2a; }
graph-link:preview { stroke = #365f8b; stroke-dasharray = 8; }
graph-badge { background-color = #302c27; color = #fffdf6; border-radius = 2; }
graph-badge:warning { background-color = #9d6800; }
graph-badge:error { background-color = #a62d2a; }
graph-flow { background-color = #31775f; }
graph-flow-label { background-color = #fffdf6; color = $ink; border-color = #31775f; border-radius = 2; }
graph-minimap { background-color = #fffdf6ee; border-color = #b6aa92; border-width = 1; }
graph-minimap-node { background-color = #b6aa92; }
graph-minimap-viewport, graph-focus { border-color = $accent; }
graph-marquee { background-color = #365f8b22; border-color = $accent; }
// FSM sample
.fsm graph-node.fsm-entry { width = 110; }
.fsm graph-node.fsm-state { width = 200; }
.fsm graph-node.fsm-transition { width = 180; border-style = dashed; }
.fsm graph-title { font-size = 14; }
.fsm graph-node.fsm-active { background-color = #e0eaf0; border-color = $accent; border-width = 3; }
fsm-inspector { background-color = $surface; color = $ink; height = fit; padding = 8; border-radius = 6; }

// Compact Excalibur application chrome and authored group frames.
graph-playground button, graph-playground dropdown, graph-playground listbox, graph-playground menu {
    background-color = $surface; color = $ink; border-color = #938979; border-width = 1; border-radius = 4;
}
graph-playground menubar, graph-playground menu-title, graph-playground menu-item,
graph-playground option, graph-playground value, graph-playground placeholder { color = $ink; }
graph-playground button:focus, graph-playground dropdown:focus, graph-playground option:focus,
graph-playground menu-item:highlighted { outline-color = $accent; outline-width = 2; }
graph-group { background-color = transparent; border-color = #938979; border-width = 1; border-radius = 6; }
graph-group:selected { border-color = $accent; border-width = 2; }
graph-group:collapsed, graph-group-header { background-color = $surface; color = $ink; }
graph-playground input { color = $ink; background-color = #fffdf8; }
graph-playground button.icon { color = $ink; }
