<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Autoformers</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- NuGet Package Properties -->
        <Title>Autoformers for Excalibur</Title>
        <PackageId>Autoformers.Excalibur</PackageId>
        <Description>Draws Autoformers models with Excalibur controls: labelled rows, collections, nested objects and scoped, disposable drawer registries. Styled through inherited Guinevere control tokens.</Description>
        <Company>MASS4</Company>
        <Product>Guinevere</Product>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Version>5.4.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Guinevere/Guinevere.csproj"/>
        <ProjectReference Include="../Guinevere.Excalibur/Guinevere.Excalibur.csproj"/>
        <ProjectReference Include="../Autoformers/Autoformers.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Guinevere.Tests"/>
    </ItemGroup>

</Project>
