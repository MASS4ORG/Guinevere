<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Guinevere</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- NuGet Package Properties -->
        <Title>Guinevere - Styling</Title>
        <PackageId>MASS4.Guinevere.Styling</PackageId>
        <Description>
            PanGui-compatible .pss stylesheets for Guinevere: selectors, nesting, inheritance, layered tokens,
            reloadable theme files and a cached resolver behind gui.StyledNode and gui.ResolveStyle.
        </Description>
        <Company>MASS4</Company>
        <Product>Guinevere</Product>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Version>5.8.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Guinevere/Guinevere.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Guinevere.Tests" />
    </ItemGroup>

</Project>
